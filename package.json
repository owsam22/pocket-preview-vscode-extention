{
  "name": "pocket-preview",
  "displayName": "pocket-preview",
  "description": "a live preview setup for quick access oven any network or phone",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/owsam22/pocket-preview-vscode-extention.git"
  },
  "publisher": "owsam22",
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "command": "pocketpreview.start",
        "title": "preview on phone"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/qrcode": "^1.5.6",
    "@types/tcp-port-used": "^1.0.4",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "qrcode": "^1.5.4",
    "tcp-port-used": "^1.0.2"
  }
}
